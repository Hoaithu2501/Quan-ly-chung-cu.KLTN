# Copy to .env. scripts/init_db.py generates strong local secrets if absent.
JWT_SECRET=
SERVICE_TOKEN=
# Python development only. Docker overrides this with /app/data/QLCC.db in its shared volume.
DATABASE_PATH=data/QLCC.db
HOST=127.0.0.1
# SePay Test Mode first. Never scan Test QR with a real banking application.
PAYMENT_MODE=sepay
SCHEDULER_ENABLED=true
SEPAY_ENV=test
# For Live, use the linked real bank account, Live webhook and Live API token (if enabled).
# MB API Banking works with the main account; no virtual account is required for this integration.
# Copy from a bank account created inside SePay Test Mode (for example VCB / Vietcombank).
SEPAY_BANK_CODE=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
# Generated locally by scripts/init_db.py; enter the same key in the SePay webhook.
SEPAY_WEBHOOK_API_KEY=
# Public HTTPS origin + /api/billing/sepay/webhook. Quick tunnel URL changes on restart.
SEPAY_WEBHOOK_URL=
SEPAY_PAYMENT_PREFIX=TTHD
SEPAY_PAYMENT_WINDOW_MINUTES=15
# Optional read-only API v2 reconciliation. Token and bank-account UUID must match SEPAY_ENV.
SEPAY_API_TOKEN=
SEPAY_BANK_ACCOUNT_ID=
# Optional Firebase push: see docs/FIREBASE_PUSH.md. Same path locally/in Docker.
GOOGLE_APPLICATION_CREDENTIALS=secrets/firebase-credentials.json
FIREBASE_PROJECT_ID=
FIREBASE_WEB_CONFIG=
FIREBASE_VAPID_KEY=
# Shared chatbot model for every user; configured only on the server.
# Paraphrasing stays disabled until a valid API key is supplied.
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=15
# Keep thinking short for FAQ answers; Gemini 3 cannot use none.
LLM_REASONING_EFFORT=minimal
# Optional own-invoice lookup: resident JWT only, data is never sent to the LLM.
CHATBOT_RESIDENT_CONTEXT_ENABLED=false
