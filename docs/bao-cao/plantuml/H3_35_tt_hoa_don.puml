@startuml H3_35_tt_hoa_don
!include _style.iuml
title Biểu đồ trạng thái – Hóa đơn
[*] --> unpaid : BQL lập hóa đơn
unpaid : Chưa thanh toán
paid : Đã thanh toán
overdue : Quá hạn
unpaid --> unpaid : BQL sửa phí / hạn\n(khi chưa phát hành QR)
unpaid --> paid : nhận đủ tiền (SePay)\nhoặc BQL ghi nhận tiền mặt
unpaid --> overdue : job 00:05, due_date < hôm nay\n[trigger tạo phiếu cut_service]
overdue --> paid : thanh toán công nợ\n[gửi invoice_settled]
paid --> [*]
@enduml
