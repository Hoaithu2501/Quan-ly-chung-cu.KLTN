@startuml H3_13_hd_dang_ky_xe
!include _style.iuml
title Biểu đồ hoạt động – Đăng ký gửi xe tháng
|Cư dân|
start
:Gửi đơn đăng ký gửi xe
tại "Khiếu nại & đăng ký";
|Ban quản lý|
:Duyệt đơn (hệ thống tự tạo xe),
hoặc vào "Quản lý gửi xe" → "Đăng ký xe";
:Nhập căn hộ, loại xe, biển số,
ngày bắt đầu, số tháng (mới ≥ 2, gia hạn ≥ 1,
tối đa đến hết kỳ sáu tháng);
|Parking Service|
if (Loại xe hợp lệ?\n(xe đạp, xe máy, xe điện)) then (Không)
  :Từ chối (không nhận ô tô);
  stop
endif
if (Xe máy / xe điện thiếu biển số?) then (Có)
  :Báo thiếu biển số;
  stop
endif
if (Xe đạp không có biển?) then (Đúng)
  :Cấp mã <căn hộ>-XD-<id>;
endif
if (Biển số đang hoạt động ở cùng căn hộ?) then (Có)
  :Gia hạn xe đó (còn hạn: nối tiếp;
  hết hạn: đăng ký mới từ hôm nay);
  stop
endif
:Gán phí tháng theo loại xe;
:Phí thẻ = 0 nếu xe đã từng có thẻ,
ngược lại 100.000đ;
:Lưu đăng ký, tính ngày hết hạn theo lịch
("Gửi đến hết ngày …");
|Cư dân|
:Xem xe và phí trong mục Gửi xe;
stop
@enduml
