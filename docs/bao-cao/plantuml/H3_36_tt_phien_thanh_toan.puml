@startuml H3_36_tt_phien_thanh_toan
!include _style.iuml
title Biểu đồ trạng thái – Phiên thanh toán VietQR
[*] --> pending : cư dân chọn Thanh toán
pending : Chờ chuyển khoản (15 phút)
awaiting_confirmation : Chờ ngân hàng xác nhận
success : Thành công
expired : Hết thời gian hiển thị QR
cancelled : Đã hủy
pending --> awaiting_confirmation : "Tôi đã chuyển khoản"
pending --> success : webhook / API đủ tiền
pending --> expired : quá hạn phiên
pending --> cancelled : chủ phiên hủy\n[chưa nhận tiền]
pending --> pending : nhận thiếu tiền\n(QR mới = số còn thiếu)
awaiting_confirmation --> success : đối soát đủ tiền
expired --> success : tiền đến trễ vẫn đối soát
cancelled --> success : tiền đến trễ vẫn đối soát
success --> [*]
@enduml
