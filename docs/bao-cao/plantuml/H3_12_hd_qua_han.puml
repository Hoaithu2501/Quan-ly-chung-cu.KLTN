@startuml H3_12_hd_qua_han
!include _style.iuml
title Biểu đồ hoạt động – Xử lý hóa đơn quá hạn và khôi phục dịch vụ
|Bộ lập lịch|
start
:00:05 hằng ngày (hoặc khi Billing khởi động),
hoặc ngay khi hóa đơn được lập / sửa với hạn đã qua;
|Billing Service|
:Tìm hóa đơn chưa thanh toán có hạn < hôm nay;
while (Còn hóa đơn?) is (Có)
  :Cập nhật trạng thái → "Quá hạn";
  :Ghi outbox thông báo quá hạn tới căn hộ;
endwhile (Hết)
:Gửi báo cáo tổng hợp quá hạn tới BQL, kỹ thuật viên;
:Nhắc hạn các hóa đơn đến hạn trong 3 ngày;
|Kỹ thuật viên|
:Mở "Quản lý dịch vụ", chọn dịch vụ cần cắt
(điện, nước / dịch vụ chung, gửi xe);
|Billing Service|
if (Hóa đơn đang quá hạn và dịch vụ chưa bị cắt?) then (Không)
  :Từ chối;
  stop
endif
:Lưu invoice_service_cuts (cut),
thông báo cư dân và BQL;
|Cư dân|
:Thanh toán công nợ;
|Billing Service|
:Hóa đơn → "Đã thanh toán";
:Báo kỹ thuật viên cần cấp lại các dịch vụ đang cắt;
|Kỹ thuật viên|
:Chọn "Cấp lại" từng dịch vụ;
|Billing Service|
if (Hóa đơn đã thanh toán?) then (Có)
  :Cập nhật invoice_service_cuts (restored),
  thông báo cư dân và BQL;
else (Không)
  :Từ chối;
endif
stop
@enduml
